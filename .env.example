# Copy to .env on the Docker host (never committed).
HOST_PORT=8420
# Set a password to require HTTP basic auth (user name below). Empty = no login.
OMAPS_USER=rik
OMAPS_PASSWORD=
# Public site (Publish page): a GitHub fine-grained token with access to the
# site repository only, with Contents and Pages set to "Read and write".
OMAPS_GITHUB_TOKEN=
# Strava (Runs page): create an API app at https://www.strava.com/settings/api and set
# its "Authorization Callback Domain" to the host name you open this app with (e.g. 192.168.1.20).
OMAPS_STRAVA_CLIENT_ID=
OMAPS_STRAVA_CLIENT_SECRET=

# O'Punch calendar (opunch.org): pulled once a day, no account needed. Set to 0 to turn the daily pull off.
OMAPS_OPUNCH_AUTO_PULL=1
